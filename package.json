  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "assets:prune": "node scripts/prune-mobile-artworks.mjs",
    "prebuild": "npm run assets:prune",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/test-library.mjs",
    "library:build": "node scripts/build-library-data.mjs",
    "assets:update": "node scripts/update-assets.mjs",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --apk --target aarch64",
    "android:aab": "tauri android build --aab"
