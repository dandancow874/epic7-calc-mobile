    "adm-zip": "^0.6.1",
    "playwright": "^1.61.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lodash-es": "^4.18.1",
